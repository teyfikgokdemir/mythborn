{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mythborn-preview",
  "main": "src/analytics-router.js",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "preview",
    "ADMIN_EMAILS": "tevfikgokdemir@gmail.com",
    "PREMIUM_STARTS_AT": "2026-09-01T00:00:00+03:00",
    "PREMIUM_GATE_ENABLED": "false",
    "COMING_SOON_ENABLED": "true"
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/llms.txt", "/llms.en.txt", "/llms.gr.txt", "/llms.es.txt", "/llms.ar.txt", "/llms.el.txt", "/llms-full.txt", "/llms-full.en.txt", "/llms-full.gr.txt", "/llms-full.es.txt", "/llms-full.ar.txt", "/llms-full.el.txt", "/ai-fact-sheet.json", "/sitemap-video.xml", "/.well-known/*"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mythborn-membership-preview",
      "database_id": "82d3d933-282d-4369-b68e-cee26b66349b",
      "migrations_dir": "migrations"
    }
  ]

  // Required secrets/vars:
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  // PAYMENT_WEBHOOK_SECRET
  // TURNSTILE_SITE_KEY, TURNSTILE_SECRET
}
