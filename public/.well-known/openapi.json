{
  "openapi": "3.0.3",
  "info": {
    "title": "Mythborn Public Discovery API",
    "version": "1.0.0",
    "description": "Informational, read-only access."
  },
  "servers": [
    {
      "url": "https://mythborn.co"
    }
  ],
  "paths": {
    "/api/search-index": {
      "get": {
        "summary": "Retrieve a localized search index",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "tr",
                "en",
                "el",
                "es"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Localized search index"
          }
        }
      }
    }
  }
}
