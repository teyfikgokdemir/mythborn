{
  "openapi": "3.1.0",
  "info": {
    "title": "Mythborn Public Search API",
    "description": "Public educational content index",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://mythborn.co"
    }
  ],
  "paths": {
    "/api/search-index": {
      "get": {
        "summary": "Search public educational resources",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "tr",
                "en",
                "el",
                "es"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Content index"
          }
        }
      }
    }
  }
}