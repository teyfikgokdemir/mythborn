# Mythborn Platform Environment Variables & Secrets Example
# DİKKAT: Gerçek token, API anahtarı veya kişisel sırları bu dosyaya veya git reposuna YAZMAYIN.
# Yerel geliştirme için bu dosyayı '.dev.vars' olarak kopyalayın.

# --- ÇALIŞMA ORTAMI AYARLARI (Cloudflare Worker Vars) ---
ENVIRONMENT=production
ADMIN_EMAILS=admin@example.com
PREMIUM_STARTS_AT=2026-09-01T00:00:00+03:00
PREMIUM_GATE_ENABLED=false
COMING_SOON_ENABLED=false
GOZDE_LAUNCH_ENABLED=true

# --- FORM VE YÖNETİM GÜVENLİĞİ ---
# /api/gozde-submissions paneli için yönetici erişim anahtarı
GOZDE_ADMIN_PASSWORD=change-to-a-strong-secret-key

# --- CLOUDFLARE TURNSTILE (Bot ve Spam Koruması) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- E-POSTA VE ÖDEME WEBHOOKLARI ---
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# --- SOSYAL GİRİŞ (OAuth - Opsiyonel / Uyuyan Modül) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- ARAMA MOTORU İNDEKSLEME ---
# IndexNow protokolü için onay anahtarı (public/ altındaki txt dosyasıyla eşleşir)
INDEXNOW_KEY=085d3ee74a549adae9549528a2fb1ad1
