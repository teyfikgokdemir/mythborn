{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mythborn",
  "main": "src/router.js",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }

  // D1 oluşturulduktan sonra aşağıdaki binding Cloudflare panelinden veya
  // `wrangler d1 create` çıktısındaki database_id ile buraya eklenmelidir:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "mythborn-membership",
  //     "database_id": "<D1_DATABASE_ID>",
  //     "migrations_dir": "migrations"
  //   }
  // ]
  //
  // Zorunlu secret/vars:
  // ADMIN_EMAILS, PAYMENT_WEBHOOK_SECRET
  //
  // Turnstile etkinleştirilecekse:
  // TURNSTILE_SITE_KEY, TURNSTILE_SECRET
  //
  // E-posta sağlayıcısı bağlandığında EMAIL binding kullanılacaktır.
}