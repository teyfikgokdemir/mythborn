{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mythborn",
  "main": "src/router.js",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
  // Production bindings to add in Cloudflare after resource creation:
  // "d1_databases": [{ "binding": "DB", "database_name": "mythborn-membership", "database_id": "<D1_DATABASE_ID>" }]
  // Secrets: PAYMENT_WEBHOOK_SECRET
  // Optional email service binding: EMAIL
}
