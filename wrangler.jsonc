{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mythborn",
  "main": "src/analytics-router.js",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "production",
    "ADMIN_EMAILS": "tevfikgokdemir@gmail.com",
    "PREMIUM_STARTS_AT": "2026-09-01T00:00:00+03:00",
    "PREMIUM_GATE_ENABLED": "false"
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/llms.txt", "/llms.en.txt", "/llms.gr.txt", "/llms.es.txt", "/llms.el.txt"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mythborn-membership",
      "database_id": "99490fbd-8f6c-4bf9-b5ed-bffdfdbd8771",
      "migrations_dir": "migrations"
    }
  ]

  // Required secrets/vars:
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  // PAYMENT_WEBHOOK_SECRET
  // TURNSTILE_SITE_KEY, TURNSTILE_SECRET
}
