{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mythborn",
  "main": "src/premium-router.js",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "preview",
    "ADMIN_EMAILS": "tevfikgokdemir@gmail.com"
  },
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mythborn-membership-preview",
      "database_id": "82d3d933-282d-4369-b68e-cee26b66349b",
      "migrations_dir": "migrations"
    }
  ]

  // Required secrets/vars:
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  // PAYMENT_WEBHOOK_SECRET
  // TURNSTILE_SITE_KEY, TURNSTILE_SECRET
}